# Copy to .env and fill locally. NEVER commit real .env values.
# Env vars override config.yaml. Rotate credentials if they were ever shared.

# ServiceNow
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USER=your-servicenow-user
SERVICENOW_PASS=your-servicenow-password
SERVICENOW_API_KEY=your-servicenow-api-key

# LLM / AI provider: huggingface | azure_openai
LLM_PROVIDER=huggingface
LLM_MODEL=google/flan-t5-base
HF_MODEL_NAME=google/flan-t5-base
LLM_MAX_NEW_TOKENS=512

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_MODEL=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
ELASTICSEARCH_INDEX_NAME=articles
ELASTICSEARCH_FAILURE_INDEX=article_failures
ELASTICSEARCH_USE_SSL=false

# App API auth (send header X-API-Key). Required before exposing the service.
API_KEY=your-app-api-key
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
DISABLE_API_DOCS=false
HTTP_TIMEOUT_SECONDS=30

# Optional OCR binary path (no user-profile hardcoding in code)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Chunking
CHUNK_OVERLAP=50
CHUNK_SIZE=512

# Logging
LOG_LEVEL=INFO
